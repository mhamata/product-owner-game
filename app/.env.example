# Praxis environment configuration. Copy to .env.local and fill in.

# --- AI grading / roleplay / retro (required for live AI features) ---
ANTHROPIC_API_KEY=

# --- Supabase (Phase-0 substrate: accounts, sync, entitlements, AI budgets) ---
# Project: praxis (dkciotyvrcepopwgtowe), region ca-central-1
NEXT_PUBLIC_SUPABASE_URL=https://dkciotyvrcepopwgtowe.supabase.co
# Publishable anon key (safe for the client; RLS is the boundary):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRrY2lvdHl2cmNlcG9wd2d0b3dlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMzODM5ODQsImV4cCI6MjA5ODk1OTk4NH0.XB_NYkUB2tEcQxL7xsAhr7fR2FqOaIxATCnz15Ed7JI
# Service-role key: Supabase dashboard -> Project Settings -> API keys.
# SERVER ONLY. Never expose with a NEXT_PUBLIC_ prefix, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI route auth mode ---
# off      = today's behavior: anonymous, in-memory rate limits only (default)
# required = verified Supabase JWT + per-user monthly AI budget (user_budgets)
PRAXIS_AUTH_MODE=off

# --- Stripe checkout (slice D: Interview Gym paywall) ---
# SERVER ONLY. The secret key and webhook secret must never be committed and
# must never carry a NEXT_PUBLIC_ prefix. Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Publishable key is safe on the client. UNUSED by the code today (we use
# Stripe-hosted Checkout redirects, no client-side Stripe.js), kept here so the
# key is ready if we ever mount Elements. Dashboard -> Developers -> API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (Dashboard -> Product catalog). Sprint = $99 one-time six-week
# access; Monthly = $39/mo subscription with a 3-day trial. An unset price ID
# makes that plan degrade to a calm "payments off" 200.
STRIPE_PRICE_SPRINT=
STRIPE_PRICE_MONTHLY=
# Webhook signing secret (starts whsec_...). Set after creating the endpoint in
# the Stripe dashboard, or from `stripe listen --forward-to \
# localhost:3000/api/stripe-webhook` for local testing.
STRIPE_WEBHOOK_SECRET=
